{
  // ==========================================================================
  // PLAZA · configuración del Worker
  //
  // Va aparte del Worker de Chispa (worker/) a propósito: aquel responde a
  // cualquiera y no guarda nada; este pide sesión y guarda todo.
  //
  // ANTES DE DESPLEGAR hay tres cosas que no están aquí y no pueden estarlo:
  //
  //   npx wrangler d1 create emprendo-plaza      -> pega el id abajo
  //   npx wrangler secret put PIMIENTA           -> 32+ caracteres al azar
  //   npx wrangler d1 migrations apply emprendo-plaza --remote
  //
  // La PIMIENTA es lo que hace que la huella de un correo no se pueda
  // adivinar probando correos comunes. Si se pierde, nadie puede volver a
  // entrar con su correo de siempre: cambiarla equivale a borrar todas las
  // cuentas. Guárdala donde guardes lo importante.
  // ==========================================================================

  "name": "plaza",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // La cuenta, escrita a mano y a propósito.
  //
  // Sin esto, wrangler despliega en la cuenta que tenga la sesión abierta, y
  // eso ya salió mal una vez: la base y el Worker acabaron en una cuenta y el
  // dominio en otra. Cloudflare exige que el dominio del correo viva en la
  // MISMA cuenta que el Worker, así que aquello no habría podido mandar ni un
  // enlace de acceso.
  //
  // Esta es la cuenta que tiene emprendo.life y el plan de pago. Con el id
  // aquí, un despliegue desde la cuenta equivocada falla en vez de acertar
  // por casualidad.
  "account_id": "740434c6ad262092cf983617356a3a15",

  // El dominio propio. Además de quedar mejor, quita de la URL el subdominio
  // de workers.dev, que es el nombre de la cuenta — o sea, el correo del
  // dueño a la vista de cualquiera que abra las herramientas del navegador.
  "routes": [
    { "pattern": "plaza.emprendo.life", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emprendo-plaza",
      // Lo imprime `wrangler d1 create`. Región WNAM, en la cuenta de arriba.
      "database_id": "4ee8d3b6-21ad-409f-bc74-03e8c16c9283"
    }
  ],

  // El envío de correo por binding, sin ninguna clave que guardar. Requiere
  // el plan Workers Paid y el dominio dado de alta:
  //   npx wrangler email sending enable emprendo.life
  //
  // Si se prefiere el camino gratis con un servicio externo, se comenta este
  // bloque y se ponen CORREO_API_URL y CORREO_API_KEY como secretos.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Ráfagas por IP. Más apretado que el de Chispa: aquí cada petición toca
  // la base, y quien pruebe tokens a lo bruto entra por aquí.
  "ratelimits": [
    { "name": "LIMITE_IP", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    // Las direcciones COMPLETAS de la app, con carpeta si la tiene. No solo
    // el origen: la cabecera `Origin` del navegador nunca lleva la ruta, y
    // sin ella el enlace de acceso sale apuntando a la raíz del dominio. En
    // GitHub Pages eso es un 404.
    //
    // NO se pone localhost: en el Worker de Chispa da igual porque solo hay
    // IA, pero aquí viaja la sesión dentro del cuerpo, y cualquier página
    // servida en ese puerto podría llamar a esta API. Para desarrollo se usa
    // `wrangler dev`, que trae su propio origen.
    "ORIGENES": "https://app.emprendo.life,https://erickzoneee.github.io/modo-emprendedor",
    "APP_URL": "https://app.emprendo.life",
    "CORREO_DESDE": "hola@emprendo.life"
  },

  // Se deja encendida: es lo único que va a contar qué pasó cuando algo
  // falle. La regla que la hace segura está en el código y no aquí — no se
  // registra nunca el cuerpo de una petición, porque ahí viaja la sesión.
  "observability": { "enabled": true }
}
